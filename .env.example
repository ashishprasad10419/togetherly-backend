# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:8081

# Database
MONGO_URI=mongodb://127.0.0.1:27017/togetherly

# Auth
JWT_ACCESS_SECRET=replace_with_long_random_secret_access
JWT_REFRESH_SECRET=replace_with_long_random_secret_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
BCRYPT_ROUNDS=12

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OTP (dev only — in prod plug into SMS provider like Twilio)
OTP_TTL_SECONDS=300
